{
  "name": "reallens-episode",
  "version": "2.0.0",
  "private": true,
  "main": "episode.js",
  "scripts": {
    "audio": "node generate_audio.js",
    "audio:audit": "node generate_audio.js --audit-only",
    "sync": "node sync_hyperframes.js",
    "lint": "node hf.js lint",
    "check": "node hf.js check",
    "timeline": "node hf.js timeline",
    "snapshot": "node hf.js snapshot --review",
    "preview": "node hf.js preview",
    "audit": "node audit_all_scenes.js",
    "qa:narration": "node audit_all_scenes.js --qa-only",
    "render:draft": "node render_mp4.js --720p --fps 24 -o draft_720p.mp4",
    "render:fast": "node render_mp4.js --grade horror --cq 17 -o master_hf.mp4",
    "render:hq": "node render_mp4.js --hq --grade horror -o master_hf.mp4",
    "render:hf": "node hf.js render -f 30 -q looks --gpu --browser-gpu -o master_hf.mp4",
    "render:4k": "node hf.js render -f 30 -q looks --resolution 4k --gpu --browser-gpu -o master_4k.mp4",
    "render": "node render_mp4.js --grade horror --cq 17 -o master_hf.mp4",
    "thumbs": "node generate_thumbnail.js --strict",
    "shorts:overlays": "node generate_shorts_overlays.js --format cliffhanger",
    "shorts:render": "node render_all_shorts.js --format cliffhanger",
    "shorts:covers": "node generate_scene_covers.js --format cliffhanger",
    "inspect": "node inspect_video.js master_hf.mp4 --strict"
  },
  "dependencies": {
    "@fontsource/kanit": "^5.0.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "gsap": "^3.12.5",
    "puppeteer-core": "^25.10.0"
  },
  "devDependencies": {
    "hyperframes": "^0.9.32"
  }
}
